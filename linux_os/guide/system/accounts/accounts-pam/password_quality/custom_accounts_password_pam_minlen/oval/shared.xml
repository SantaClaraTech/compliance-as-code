<def-group>
  <definition class="compliance" id="custom_accounts_password_pam_minlen" version="1">
    {{{ oval_metadata("Check minlen in pwquality.conf and absence in PAM files") }}}
    <criteria operator="AND">
      <criterion test_ref="test_custom_pwquality_minlen_conf" comment="Check minlen in pwquality.conf"/>
      <criterion test_ref="test_custom_pwquality_minlen_pam_absent" comment="Check minlen absent in PAM files"/>
    </criteria>
  </definition>

  <!-- Test 1: Presente en pwquality.conf -->
  <ind:textfilecontent54_test check="all" check_existence="all_exist" id="test_custom_pwquality_minlen_conf" version="1" comment="minlen in pwquality.conf">
    <ind:object object_ref="object_custom_pwquality_minlen_conf" />
    <ind:state state_ref="state_custom_pwquality_minlen_conf" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="object_custom_pwquality_minlen_conf" version="1">
    <ind:filepath>/etc/security/pwquality.conf</ind:filepath>
    <ind:pattern operation="pattern match">^[\s]*minlen[\s]*=[\s]*(\d+)</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>

  <ind:textfilecontent54_state id="state_custom_pwquality_minlen_conf" version="1">
    <ind:subexpression datatype="int" operation="greater than or equal" var_ref="var_password_pam_minlen" />
  </ind:textfilecontent54_state>

  <!-- Test 2: Ausente en archivos PAM -->
  <ind:textfilecontent54_test check="all" check_existence="none_exist" id="test_custom_pwquality_minlen_pam_absent" version="1" comment="minlen absent in PAM">
    <ind:object object_ref="object_custom_pwquality_minlen_pam_absent" />
  </ind:textfilecontent54_test>

  <ind:textfilecontent54_object id="object_custom_pwquality_minlen_pam_absent" version="1">
    <ind:filepath operation="pattern match">^/etc/pam\.d/(system-auth|password-auth)$</ind:filepath>
    <ind:pattern operation="pattern match">^\s*password\s+.*pam_pwquality\.so.*\s+minlen=</ind:pattern>
    <ind:instance datatype="int">1</ind:instance>
  </ind:textfilecontent54_object>
</def-group>
