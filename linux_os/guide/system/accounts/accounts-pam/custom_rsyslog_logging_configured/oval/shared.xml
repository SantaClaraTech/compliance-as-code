  <ind:textfilecontent54_object id="obj_rsyslog_warn_err" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*\*\.=warning;\*\.=err[\s]+-/var/log/warn[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

