  <ind:textfilecontent54_object id="obj_rsyslog_mail_warn" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*mail\.warning[\s]+-/var/log/mail\.warn[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

