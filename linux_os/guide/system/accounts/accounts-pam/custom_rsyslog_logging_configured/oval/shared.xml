  <ind:textfilecontent54_object id="obj_rsyslog_messages" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*\*\.\*;mail\.none;news\.none[\s]+-/var/log/messages[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local45" check="all" check_existence="all_exist" version="1" comment="13"><ind:object object_ref="obj_rsyslog_local45" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local45" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*local4,local5\.\*[\s]+-/var/log/localmessages[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

