<def-group>
  <definition class="compliance" id="{{{ rule_id }}}" version="1">
    {{{ oval_metadata("Ensure custom CIS rsyslog drop-in contains exact required configurations") }}}
    <criteria operator="AND">
      <criterion comment="mail.err" test_ref="test_rsyslog_mail_err" />
      <criterion comment="local6,local7" test_ref="test_rsyslog_local67" />
      <criterion comment="auth,authpriv" test_ref="test_rsyslog_auth" />
      <criterion comment="local2,local3" test_ref="test_rsyslog_local23" />
      <criterion comment="warning,err" test_ref="test_rsyslog_warn_err" />
      <criterion comment="emerg" test_ref="test_rsyslog_emerg" />
      <criterion comment="mail.info" test_ref="test_rsyslog_mail_info" />
      <criterion comment="mail.all" test_ref="test_rsyslog_mail_all" />
      <criterion comment="crit" test_ref="test_rsyslog_crit" />
      <criterion comment="cron" test_ref="test_rsyslog_cron" />
      <criterion comment="mail.warn" test_ref="test_rsyslog_mail_warn" />
      <criterion comment="messages" test_ref="test_rsyslog_messages" />
      <criterion comment="local4,local5" test_ref="test_rsyslog_local45" />
      <criterion comment="local0,local1" test_ref="test_rsyslog_local01" />
