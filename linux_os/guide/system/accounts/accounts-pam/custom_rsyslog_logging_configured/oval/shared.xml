  </definition>

  <ind:textfilecontent54_test id="test_rsyslog_mail_err" check="all" check_existence="all_exist" version="1" comment="1"><ind:object object_ref="obj_rsyslog_mail_err" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_mail_err" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*mail\.err[\s]+/var/log/mail\.err[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_local67" check="all" check_existence="all_exist" version="1" comment="2"><ind:object object_ref="obj_rsyslog_local67" /></ind:textfilecontent54_test>
  <ind:textfilecontent54_object id="obj_rsyslog_local67" version="1"><ind:filepath>/etc/rsyslog.d/99-cis-custom-logging.conf</ind:filepath><ind:pattern operation="pattern match">^[\s]*local6,local7\.\*[\s]+-/var/log/localmessages[\s]*$</ind:pattern><ind:instance datatype="int">1</ind:instance></ind:textfilecontent54_object>

  <ind:textfilecontent54_test id="test_rsyslog_auth" check="all" check_existence="all_exist" version="1" comment="3"><ind:object object_ref="obj_rsyslog_auth" /></ind:textfilecontent54_test>
