<def-group>
  <definition class="compliance" id="custom_file_ownership_home_directories" version="1">
    {{{ oval_metadata("Interactive users and root must own their home directories") }}}
    <criteria operator="AND">
      <criterion test_ref="test_custom_file_ownership_home_directories" comment="Interactive users own their home dirs"/>
      <criterion test_ref="test_custom_file_ownership_root_home" comment="Root owns /root"/>
    </criteria>
  </definition>

  {{%- set interactive_users_home_dirs_object = "object_custom_file_ownership_home_dirs" -%}}
  {{{ create_local_interactive_users_home_dirs_list_object(interactive_users_home_dirs_object) }}}
  {{%- set interactive_users_uids_object = "object_custom_file_ownership_uids" -%}}
  {{{ create_local_interactive_users_uids_list_object(interactive_users_uids_object) }}}

  <local_variable id="var_custom_file_ownership_home_dirs" datatype="string" version="1" comment="Home dirs from interactive users">
    <object_component item_field="subexpression" object_ref="{{{ interactive_users_home_dirs_object }}}"/>
  </local_variable>

  <local_variable id="var_custom_file_ownership_uids" datatype="int" version="1" comment="Interactive users uids">
    <object_component item_field="subexpression" object_ref="{{{ interactive_users_uids_object }}}"/>
  </local_variable>

  <unix:file_object id="object_custom_file_ownership_home_dirs_file" version="1">
    <unix:path var_ref="var_custom_file_ownership_home_dirs" var_check="at least one"/>
    <unix:filename xsi:nil="true"/>
  </unix:file_object>

  <unix:file_state id="state_custom_file_ownership_uids" version="1">
    <unix:user_id datatype="int" var_check="only one" var_ref="var_custom_file_ownership_uids"/>
  </unix:file_state>

  <unix:file_test id="test_custom_file_ownership_home_directories" check="all" check_existence="any_exist" version="1" comment="All home directories are owned by a local interactive user">
    <unix:object object_ref="object_custom_file_ownership_home_dirs_file"/>
    <unix:state state_ref="state_custom_file_ownership_uids"/>
  </unix:file_test>

  <unix:file_test id="test_custom_file_ownership_root_home" check="all" check_existence="all_exist" version="1" comment="Check /root owner">
    <unix:object object_ref="object_custom_file_ownership_root_home" />
    <unix:state state_ref="state_custom_file_ownership_root_home" />
  </unix:file_test>
  
  <unix:file_object id="object_custom_file_ownership_root_home" version="1">
    <unix:path>/root</unix:path>
    <unix:filename xsi:nil="true" />
  </unix:file_object>
  
  <unix:file_state id="state_custom_file_ownership_root_home" version="1">
    <unix:user_id datatype="int">0</unix:user_id>
  </unix:file_state>
</def-group>
